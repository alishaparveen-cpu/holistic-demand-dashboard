unselling","kw":"counsellor near me","sv":8100},{"city":"National","g":"counselling","kw":"marriage counselling near me","sv":1300},{"city":"National","g":"counselling","kw":"relationship counselling near me","sv":1600},{"city":"National","g":"counselling","kw":"online counsellor","sv":3600},{"city":"National","g":"counselling","kw":"career counselling near me","sv":5400},{"city":"National","g":"psychiatrist","kw":"psychiatric hospital near me","sv":4400},{"city":"National","g":"psychiatrist","kw":"psychiatrist for depression near me","sv":70},{"city":"National","g":"conditions","kw":"anxiety treatment","sv":12100},{"city":"National","g":"conditions","kw":"depression treatment","sv":2400},{"city":"National","g":"conditions","kw":"adhd treatment","sv":9900},{"city":"National","g":"conditions","kw":"ocd treatment","sv":9900},{"city":"National","g":"conditions","kw":"bipolar treatment","sv":210},{"city":"National","g":"conditions","kw":"stress management","sv":49500},{"city":"National","g":"conditions","kw":"panic attack treatment","sv":8100},{"city":"National","g":"conditions","kw":"anxiety doctor near me","sv":1900},{"city":"National","g":"conditions","kw":"depression doctor near me","sv":1000},{"city":"National","g":"conditions","kw":"insomnia treatment","sv":22200},{"city":"National","g":"conditions","kw":"schizophrenia treatment","sv":5400}]};
const CATS=D.cats, CIDS=CATS.map(c=>c.id);
const fmt=n=>n?n.toLocaleString('en-IN'):'—';
const catColor=Object.fromEntries(CATS.map(c=>[c.id,c.color]));
const catLabel=Object.fromEntries(CATS.map(c=>[c.id,c.label]));
// ---- matrix ----
function shade(v,max,hex){ if(!v)return '#fff'; const a=0.10+0.55*Math.min(1,v/max); return hex+Math.round(a*255).toString(16).padStart(2,'0'); }
function renderMatrix(){
  const cities=Object.keys(D.citycat).map(c=>({c,row:D.citycat[c],tot:CIDS.reduce((s,id)=>s+(D.citycat[c][id]||0),0)}));
  cities.sort((a,b)=>b.tot-a.tot);
  const colMax={}; CIDS.forEach(id=>colMax[id]=Math.max(...cities.map(x=>x.row[id]||0),1));
  const totMax=Math.max(...cities.map(x=>x.tot),1);
  let h='<div class="scroll"><table><thead><tr><th class="l">City</th>';
  CATS.forEach(c=>h+=`<th style="color:${c.color}">${c.label}<div class="muted" style="font-weight:400">${c.sub||''}</div></th>`);
  h+='<th class="tot">Total</th></tr></thead><tbody>';
  cities.forEach(x=>{ h+=`<tr><td class="city">${x.c}</td>`;
    CIDS.forEach(id=>{const v=x.row[id]||0; h+=`<td style="background:${shade(v,colMax[id],catColor[id])}">${fmt(v)}</td>`;});
    h+=`<td class="tot" style="background:${shade(x.tot,totMax,'#2f7d32')}">${fmt(x.tot)}</td></tr>`; });
  const natTot=CIDS.reduce((s,id)=>s+(D.national[id]||0),0);
  h+=`<tr class="natrow"><td class="l">National (all-India reference)</td>`;
  CIDS.forEach(id=>h+=`<td>${fmt(D.national[id]||0)}</td>`); h+=`<td>${fmt(natTot)}</td></tr>`;
  h+='</tbody></table></div><div class="note">Cell shading is relative within each column. City totals sum the six categories. The National row is the all-India volume for the same keywords (reference only — not added to cities).</div>';
  document.getElementById('matrix').innerHTML=h;
}
// ---- query view ----
let qsort={k:'sv',dir:-1};
function renderQuery(){
  const cityOpts=['All cities',...Object.keys(D.citycat).sort(),'National'];
  let h='<div class="controls">'
    +'<select id="qcity">'+cityOpts.map(c=>`<option>${c}</option>`).join('')+'</select>'
    +'<select id="qcat"><option value="">All categories</option>'+CATS.map(c=>`<option value="${c.id}">${c.label}</option>`).join('')+'</select>'
    +'<input id="qmin" type="number" placeholder="min vol" style="width:90px">'
    +'<input id="qtext" placeholder="filter keyword…" style="width:170px">'
    +'<span class="muted" id="qcount"></span></div>'
    +'<div class="scroll"><table id="qtable"><thead><tr>'
    +'<th class="l" data-k="kw">Keyword</th><th class="l" data-k="g">Category</th><th class="l" data-k="city">City</th><th data-k="sv">Volume /mo</th>'
    +'</tr></thead><tbody></tbody></table></div>';
  document.getElementById('query').innerHTML=h;
  ['qcity','qcat','qmin','qtext'].forEach(id=>document.getElementById(id).addEventListener('input',fillQuery));
  document.querySelectorAll('#qtable th').forEach(th=>th.addEventListener('click',()=>{const k=th.dataset.k;qsort.dir=(qsort.k===k)?-qsort.dir:-1;qsort.k=k;fillQuery();}));
  fillQuery();
}
function fillQuery(){
  const city=document.getElementById('qcity').value, cat=document.getElementById('qcat').value;
  const mn=+document.getElementById('qmin').value||0, tx=document.getElementById('qtext').value.toLowerCase();
  let rows=D.queries.filter(q=>(city==='All cities'||q.city===city)&&(!cat||q.g===cat)&&q.sv>=mn&&(!tx||q.kw.toLowerCase().includes(tx)));
  rows.sort((a,b)=>{const k=qsort.k;let A=a[k],B=b[k];if(k==='sv')return (A-B)*qsort.dir;return (''+A).localeCompare(''+B)*qsort.dir;});
  const tb=document.querySelector('#qtable tbody');
  tb.innerHTML=rows.slice(0,1000).map(q=>`<tr><td class="l">${q.kw}</td><td class="l"><span class="pill" style="background:${catColor[q.g]}">${catLabel[q.g]}</span></td><td class="l">${q.city}</td><td class="tot">${fmt(q.sv)}</td></tr>`).join('');
  document.getElementById('qcount').textContent=rows.length+' rows · '+rows.reduce((s,q)=>s+q.sv,0).toLocaleString('en-IN')+'/mo';
}
document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',()=>{
  document.querySelectorAll('.tab').forEach(x=>x.classList.remove('on'));t.classList.add('on');
  const on=t.dataset.t; document.getElementById('matrix').classList.toggle('hide',on!=='matrix');
  document.getElementById('query').classList.toggle('hide',on!=='query');
}));
renderMatrix(); renderQuery();
</script></body></html>